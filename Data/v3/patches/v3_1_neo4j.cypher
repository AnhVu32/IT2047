// remove the nodes only the swapped rows had created (kept if anything else still uses them)
UNWIND ["former-area|ho-chi-minh-moi|phuong-chanh-hung", "former-area|ho-chi-minh-moi|phuong-hiep-binh", "former-area|ho-chi-minh-moi|phuong-long-binh", "former-area|ho-chi-minh-moi|phuong-long-truong", "former-area|ho-chi-minh-moi|phuong-nhieu-loc", "former-area|ho-chi-minh-moi|phuong-tan-binh", "former-area|ho-chi-minh-moi|phuong-thanh-my-tay", "former-area|ho-chi-minh-moi|xa-tan-vinh-loc", "street|18a47222b71516", "street|430287fba146a8", "street|75b07888bf15cb", "street|87271c3679625c", "street|a4269c34006ed5", "street|a916ec36538a6d", "street|d113f586fd3d67", "street|dc9c1a853dd907", "ward|ho-chi-minh|phuong-14", "ward|ho-chi-minh|phuong-22", "ward|ho-chi-minh|phuong-5", "ward|ho-chi-minh|phuong-9", "ward|ho-chi-minh|phuong-hiep-binh-chanh", "ward|ho-chi-minh|phuong-long-binh", "ward|ho-chi-minh|phuong-phu-huu", "ward|ho-chi-minh|xa-vinh-loc-b"] AS id MATCH (n) WHERE ((n:Ward AND n.ward_id = id) OR (n:Street AND n.street_id = id) OR (n:FormerAdminArea AND n.former_area_id = id)) AND NOT EXISTS { MATCH (n)<-[:IN_WARD|IN_FORMER_AREA|ON_STREET]-(:Listing) } DETACH DELETE n;
// recount ward <- former area mappings and former-area counters
MATCH (:Ward)-[m:MAPPED_FROM]->(:FormerAdminArea) DELETE m;
MATCH (w:Ward)<-[:IN_WARD]-(l:Listing)-[:IN_FORMER_AREA]->(f:FormerAdminArea) WITH w, f, count(l) AS n MERGE (w)-[m:MAPPED_FROM]->(f) SET m.supporting_listing_count = n;
MATCH (f:FormerAdminArea) SET f.listing_count = COUNT { (f)<-[:IN_FORMER_AREA]-(:Listing) }, f.mapped_ward_count = COUNT { (f)<-[:MAPPED_FROM]-(:Ward) };
