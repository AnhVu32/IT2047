# PostgreSQL
POSTGRES_USER=postgres
POSTGRES_PASSWORD=changeme
POSTGRES_DB=real_estate

HOST_DB=postgres
PORT_DB=5432
USERNAME_DB=postgres
PASSWORD_DB=changeme
DATABASE=real_estate
# Optional full URL used by Alembic instead of the five variables above.
# DATABASE_URL=postgresql+psycopg2://postgres:changeme@postgres:5432/real_estate

# MinIO
MINIO_ROOT_USER=minioadmin
MINIO_ROOT_PASSWORD=changeme
MINIO_END_POINT=minio:9000
MINIO_ACCESS_KEY_ID=minioadmin
MINIO_SECRET_ACCESS_KEY=changeme
MINIO_BUCKET_NAME=property-images
MINIO_SECURE=False

# Neo4j
NEO4J_AUTH=neo4j/changeme
NEO4J_URI=bolt://neo4j:7687
NEO4J_USER=neo4j
NEO4J_PASSWORD=changeme
NEO4J_DATABASE=neo4j

# App
DEBUG=True
VERSION=1.0.0
PROJECT_NAME=real-estate-recommendation-system

# Backend LLM. Keep "gemini" for the existing provider, or use any endpoint
# implementing OpenAI Chat Completions (/v1/chat/completions).
BACKEND_LLM_PROVIDER=gemini       # gemini | openai | openai-compatible | groq | grok
BACKEND_LLM_MODEL=gemini-2.5-flash
GEMINI_API_KEYS=
# BACKEND_LLM_BASE_URL=           # required for custom openai-compatible endpoints
# BACKEND_LLM_API_KEY=            # may be empty for local Ollama/vLLM endpoints

# Hybrid search (PostgreSQL FTS + pgvector + optional Neo4j graph retrieval)
# Embedding inference is provided by an OpenAI-compatible endpoint. When the
# backend runs in Docker, use http://host.docker.internal:1234/v1 instead of
# 127.0.0.1 for a local LM Studio server.
SEARCH_EMBEDDING_PROVIDER=lmstudio
SEARCH_EMBEDDING_MODEL=qwen/qwen3-embedding-4b
# SEARCH_EMBEDDING_BASE_URL=http://127.0.0.1:1234/v1
# SEARCH_EMBEDDING_API_KEY=
# SEARCH_EMBEDDING_TIMEOUT=60
# Optional for providers/models with configurable output size. The PostgreSQL
# search schema currently requires vector(1024).
# SEARCH_EMBEDDING_REQUEST_DIMENSIONS=1024
SEARCH_USE_LLM_PARSER=false

# Natural-language answer + per-listing explanation/comparison. Falls back to the
# deterministic explanation automatically when no LLM API key is configured.
SEARCH_USE_LLM_ANSWER=true

SEARCH_USE_NEO4J=true
# LangGraph chat agents. The configured OpenAI-compatible endpoint must support
# native Chat Completions tool_calls for the consultant branch.
CHAT_MODEL_TIMEOUT_SECONDS=60
CHAT_TOOL_TIMEOUT_SECONDS=90
BACKEND_URL=http://127.0.0.1:8001

# LLM tuỳ chọn cho gen_user_data (sinh raw_query/persona/description).
# Mặc định TẮT -> pipeline chạy offline bằng template + RNG.
USE_LLM=0
LLM_PROVIDER=groq                 # groq | grok | openai (đều tương thích API OpenAI)
GROQ_API_KEY=                     # lấy tại https://console.groq.com/keys
# LLM_MODEL=llama-3.3-70b-versatile
# LLM_BASE_URL=                   # ghi đè nếu dùng endpoint khác
# LLM_TEMPERATURE=0.8
# LLM_MAX_LISTINGS_DESC=150       # số listing sinh description (0 = tắt)

# Auth (simple username/password, single access token — no refresh)
ACCESS_TOKEN_SECRET_KEY=changeme
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=10080   # 7 days; long enough that there is nothing to refresh
